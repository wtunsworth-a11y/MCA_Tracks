# Data — keep out of git by default (size + sensitivity of location data).
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Exceptions: source tracks, committed deliberately so the sandbox can read
# them (it has no network route to Google Drive). Review before making this
# repo public — these carry precise location data.
!data/raw/*.gpkg
!data/raw/*.gpx
!data/raw/*.kmz
!data/raw/*.kml

# Rendered outputs
outputs/*
!outputs/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# QGIS
*.qgz~
*.qgs~

# OS
.DS_Store
Thumbs.db
