# Data — keep out of git by default (size + sensitivity of location data).
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Exceptions: source tracks, committed deliberately so the sandbox can read
# them (it has no network route to Google Drive). Review before making this
# repo public — these carry precise location data.
!data/raw/*.gpkg
!data/raw/*.gpx
!data/raw/*.kmz
!data/raw/*.kml

# Photo-laden KMZ: 141 MB of JPEGs, past GitHub's 100 MB blob limit. Its
# geometry is committed as the extracted .kml (see scripts/slim_kmz.py);
# re-fetch the original with scripts/fetch_from_drive.sh if the photos matter.
data/raw/Russell_Muraba_Trek_Record_2.kmz

# Rendered outputs — the maps themselves are the deliverable, so keep them.
outputs/*
!outputs/.gitkeep
!outputs/*.png
!outputs/*.html

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# QGIS
*.qgz~
*.qgs~

# OS
.DS_Store
Thumbs.db

# Photo-laden KMZ originals — geometry is committed as the extracted .kml
data/raw/Kawowoki_-_Kuhene_bush_treck_-_Marase_-_Umbara_2026-06-29_15-34_.kmz
