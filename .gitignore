# Data — keep out of git by default (size + sensitivity of location data).
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Rendered outputs
outputs/*
!outputs/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# QGIS
*.qgz~
*.qgs~

# OS
.DS_Store
Thumbs.db
